#!/usr/bin/env bash
#MISE description="Generate the Go client from the OpenAPI spec"
set -euo pipefail

# Name operations after their summaries instead of upstream's `METHOD_/path` operationIds
# (see README). Works on a copy so the published spec stays as upstream emits it.
spec="$(mktemp -d)/openapi.json"
trap 'rm -rf "$(dirname "$spec")"' EXIT
jq -f /dev/stdin "$OPENAPI_SPEC" > "$spec" <<'JQ'
# "Get the user's OAuth 2.0 keys" -> get-user-oauth-2-keys; PATCH's "Update …" -> patch-…
def name: .key as $method
  | [.value.summary? // empty | ascii_downcase | gsub("'s\\b|(?<=\\d)\\.0\\b"; "")
     | scan("[a-z0-9]+") | select(IN("a", "an", "the") | not)]
  | select(. != [])
  | if $method == "patch" and .[0] == "update" then .[0] = "patch" end
  | join("-");

def schema_refs: [.. | objects | .["$ref"]? // empty | select(startswith("#/components/schemas/"))
  | ltrimstr("#/components/schemas/")];
# Grows a set of schema names until it includes every schema they reference.
def reachable($schemas): (. + [.[] as $n | $schemas[$n] | schema_refs[]] | unique) as $next
  | if $next == . then . else $next | reachable($schemas) end;
def nullable: (.type | type) == "array" and (.type | index("null"));
def requests($schemas): [.paths[] | .parameters?, (.[] | objects | .requestBody?, .parameters?) | schema_refs[]]
  | unique | reachable($schemas);
def input_name: sub("(Dto)?$"; "InputDto");

([.paths[] | to_entries[] | name] | group_by(.) | map(select(length == 1)[0])) as $unique
| .paths[] |= with_entries(((name | select(IN($unique[]))) as $n | .value.operationId = $n) // .)

# Encode OIDC client IDs at the path boundary, including every nested client route.
# Match route keys here because RFC 9535 JSONPath cannot filter object keys by prefix.
| .paths |= with_entries(.key as $path | .value |= (
    (.. | objects | select(.in? == "path" and
      (.name == "clientId" or (.name == "id" and ($path | startswith("/api/admin/oidc/clients/{id}")))))
      | .schema["x-go-type"]) = "OIDCClientID"
  ))

# Upstream emits one schema per Go type, and one that requests also use keeps only the
# request's required fields. Requests get a copy named …InputDto instead, so the original
# is response-only and goes through the rule below.
| .components.schemas as $schemas
| requests($schemas) as $requests
| ([.paths[][] | objects | .responses? | schema_refs[]] | unique | reachable($schemas)) as $responses
| [$requests[] | select(IN($responses[]))] as $shared
| if any($shared[] | input_name; . as $n | $schemas | has($n)) then error("an …InputDto name is taken") end
| def to_input: walk(if type == "object" and (.["$ref"]? | type) == "string"
    and (.["$ref"] | ltrimstr("#/components/schemas/") | IN($shared[])) then .["$ref"] |= input_name end);
  .paths[] |= with_entries(.value |= if type == "object"
    then with_entries(if .key == "responses" then . else .value |= to_input end) else to_input end)
| .components.schemas |= with_entries(if .key | IN($requests[]) and (IN($shared[]) | not) then .value |= to_input end)
    + ([$shared[] | {key: input_name, value: ($schemas[.] | to_input)}] | from_entries)

# Upstream marks every pointer, slice and map nullable. Only request bodies need
# nullable.Nullable to tell unset from cleared, so schemas that appear only in responses
# drop `null`: slices, maps and strings become plain values (nil and "" stand in for null),
# while timestamps become *time.Time, since null there means "never" and the zero
# time.Time would read as long past.
# Their other fields aren't pointers upstream, so a missing one can only mean the zero value
# and they become plain too. A $ref stays optional: it is a struct pointer whose absence
# means "none".
| .components.schemas as $schemas
| requests($schemas) as $requests
| .components.schemas |= with_entries(
    if (.key | IN($requests[])) or (.value.properties | not) then . else .value |= (
      [.properties | to_entries[] | select(.value | nullable) | .key] as $nullable
      | [.properties | to_entries[] | select((.value | nullable) and .value.format == "date-time") | .key] as $timestamps
      | .required = ((.required // []) + [.properties | to_entries[] | select(.value | has("$ref") | not) | .key]
          - $timestamps | unique)
      | if $nullable == [] then . else
          .properties[$nullable[]].type |= (map(select(. != "null")) | if length == 1 then .[0] end)
        end
    ) end)
JQ

mkdir -p client
oapi-codegen -config oapi-codegen.yaml "$spec"
