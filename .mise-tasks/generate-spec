#!/usr/bin/env bash
#MISE description="Generate the OpenAPI spec from the upstream source"
#MISE depends=["clone-upstream"]
set -euo pipefail

# cmd/openapi prints the spec built from the typed route registrations, without a database or the frontend.
(cd "$UPSTREAM_DIR/backend" && go run -tags exclude_frontend ./cmd/openapi) > "$OPENAPI_SPEC"
