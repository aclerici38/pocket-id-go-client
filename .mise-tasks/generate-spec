#!/usr/bin/env bash
#MISE description="Generate the OpenAPI spec from the upstream source"
#MISE depends=["clone-upstream"]
set -euo pipefail

# cmd/openapi prints the spec built from the typed route registrations, without a database or the frontend.
(cd "$UPSTREAM_DIR/backend" && go run -tags exclude_frontend ./cmd/openapi) > "$OPENAPI_SPEC"

# The spec types ErrorDto.code as a plain string, so take its constants from apperror. grep
# fails the task if upstream moves them.
{
  printf '// Code generated by generate-spec from apperror/error.go. DO NOT EDIT.\n\npackage client\n\nconst (\n'
  grep -E '^[[:space:]]+Code[[:alnum:]]+[[:space:]]+Code = "' "$UPSTREAM_DIR/backend/internal/apperror/error.go"
  echo ')'
} > client/codes.gen.go
gofmt -w client/codes.gen.go
