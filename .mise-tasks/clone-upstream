#!/usr/bin/env bash
#MISE description="Shallow-clone upstream Pocket ID at UPSTREAM_REF (tag, branch or SHA), defaulting to POCKET_ID_VERSION"
set -euo pipefail

ref="${UPSTREAM_REF:-$(tr -d '\n' < POCKET_ID_VERSION)}"

rm -rf "$UPSTREAM_DIR"
git init -q "$UPSTREAM_DIR"
git -C "$UPSTREAM_DIR" fetch -q --depth 1 "$UPSTREAM_REPO" "$ref"
git -C "$UPSTREAM_DIR" checkout -q FETCH_HEAD
